{
  "name": "l2d-rules",
  "private": true,
  "version": "0.1.0",
  "description": "通用 LLM 驱动 Live2D 规则 SDK：语义层 + 语言A/B DSL + 校验器 + Directive IR + 求值管线 + LLM 通道（宿主无关，零平台依赖）",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test --test-isolation=none \"packages/**/test/*.test.ts\" \"examples/**/test/*.test.ts\"",
    "eval": "node scripts/eval-drive.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.6.0"
  }
}
